# Normalización de finales de línea entre Windows y Linux
# Evita que Git marque archivos completos como modificados por CRLF vs LF

* text=auto eol=lf

# Archivos que deben conservar LF
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.svg  text eol=lf

# Archivos binarios (no aplicar normalización de texto)
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
